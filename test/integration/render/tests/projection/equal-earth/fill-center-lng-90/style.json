{
  "version": 8,
  "metadata": {
    "test": {
      "description": "lambda0 == center.lng: the projection outline stays frame-fixed while the world content is centered on 90E."
    }
  },
  "center": [
    90,
    0
  ],
  "zoom": 1.2,
  "projection": {
    "type": "equal-earth"
  },
  "sources": {
    "vector_tiles": {
      "type": "vector",
      "maxzoom": 0,
      "tiles": [
        "local://tiles/{z}-{x}-{y}.mvt"
      ]
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "white"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "vector_tiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "blue"
      }
    }
  ]
}
